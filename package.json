{
  "name": "Radio-talk-killer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 dist-electron/main.cjs && electron .\"",
    "build": "vite build && tsc -p electron/tsconfig.electron.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "wait-on": "^8.0.1"
  }
}
